APP_NAME="Algorithm Design Assistant"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Damascus

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

SESSION_DRIVER=file
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=algo
DB_USERNAME=root
DB_PASSWORD=

# File-based CP content (see config/content.php)
CONTENT_CP_ROOT=
CONTENT_LEGACY_ROOT=
CONTENT_SCHEMA_ROOT=
CONTENT_CACHE_TTL=
CONTENT_INDEX_ENABLED=true

# Use "database" for async jobs; run: php artisan queue:work
QUEUE_CONNECTION=database

BROADCAST_CONNECTION=reverb

# Assistant AI provider. Only "openai" is implemented; gemini/ollama fail fast.
ASSISTANT_AI_PROVIDER=openai
OPENAI_API_KEY=
ASSISTANT_AI_MODEL=gpt-4o-mini
ASSISTANT_AI_MAX_TOKENS=500
ASSISTANT_AI_TIMEOUT=60
ASSISTANT_STT_MODEL=whisper-1
ASSISTANT_STT_TIMEOUT=30
ASSISTANT_TTS_MODEL=tts-1
ASSISTANT_TTS_TIMEOUT=30
ASSISTANT_TTS_VOICE_AR=nova
ASSISTANT_TTS_VOICE_EN=alloy

# Text-generation provider for algorithm suggestions + the Codeforces solver.
# OpenAI is primary; Ollama is the automatic fallback when the key is missing
# or a request fails. Shares OPENAI_API_KEY above.
AI_PRIMARY_PROVIDER=openai
AI_OPENAI_MODEL=gpt-4o
AI_OPENAI_MAX_TOKENS=4000
AI_OPENAI_TIMEOUT=120
AI_CODEFORCES_MAX_ATTEMPTS=3
GEMINI_API_KEY=
ASSISTANT_STT_PROVIDER=whisper
ASSISTANT_TTS_PROVIDER=openai
ASSISTANT_LOG_PROMPTS=false
ASSISTANT_LOG_RESPONSES=false
AI_USAGE_ASSISTANT_DAILY_LIMIT=100
AI_USAGE_CODEFORCES_DAILY_LIMIT=20
AI_STALE_JOB_MINUTES=15

# Local code judge (Python process runner)
# DEFAULT IS FALSE FOR SAFETY. The real judge executes AI-generated code
# without sandboxing. Only enable on dev machines, never in production
# without JUDGE_SANDBOX_DRIVER set (docker, gvisor, firejail).
# Set true on a dev machine so every solved problem is actually compiled+run.
# Requires the language toolchain (g++ for C++, python3 for Python).
JUDGE_USE_REAL=false
JUDGE_TIME_LIMIT_SECONDS=10
# JUDGE_SANDBOX_DRIVER=docker
# JUDGE_ALLOW_UNSANDBOXED_IN_PROD=false

# E2E fixture endpoint protection.
# When ENABLE_E2E_FIXTURES=false (default), /__e2e/runtime/* returns 404.
# When true, callers must also send: X-E2E-Secret: <E2E_FIXTURE_SECRET>
ENABLE_E2E_FIXTURES=false
E2E_FIXTURE_SECRET=

REVERB_APP_ID=algoag-local
REVERB_APP_KEY=algoag-local-key
REVERB_APP_SECRET=algoag-local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080

VITE_DEV_SERVER_HOST=127.0.0.1
VITE_DEV_SERVER_PORT=5173
VITE_HMR_HOST=127.0.0.1
VITE_HMR_PROTOCOL=ws

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
