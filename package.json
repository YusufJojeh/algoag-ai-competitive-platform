        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.0.1",
        "@types/react": "^18.3.28",
        "@types/react-dom": "^18.3.7",
        "@vitejs/plugin-react": "^4.3.4",
        "@vitest/coverage-v8": "^2.1.6",
        "axios": "^1.11.0",
        "jsdom": "^25.0.1",
        "laravel-echo": "^2.3.1",
        "laravel-vite-plugin": "^2.0.0",
        "pusher-js": "^8.4.3",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "tailwindcss": "^4.0.0",
        "typescript": "^6.0.2",
        "vite": "^7.0.0",
        "vitest": "^2.1.6"
