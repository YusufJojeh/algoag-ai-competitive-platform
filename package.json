{
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "lint": "tsc --noEmit",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "playwright:install": "playwright install chromium",
        "test:e2e": "playwright test",
        "test:e2e:update": "playwright test --update-snapshots",
        "test:e2e:visual": "playwright test tests/e2e/visual --workers=1",
        "test:e2e:visual:update": "playwright test tests/e2e/visual --workers=1 --update-snapshots",
        "test:all": "npm run lint && npm run test && php artisan content:validate && php artisan test",
        "test:all:coverage": "npm run test:coverage && php artisan test"
    },
    "devDependencies": {
        "@inertiajs/react": "^1.3.0",
