{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://algoag.local/schemas/solution.schema.json",
    "title": "AlgoAG reference solution manifest",
    "type": "object",
    "additionalProperties": false,
    "required": ["schema_version", "solution_id", "status", "language", "entry_file", "files"],
    "properties": {
        "schema_version": {
            "type": "integer",
            "minimum": 1
        },
        "solution_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "status": {
            "type": "string",
            "enum": ["draft", "verified", "needs_review"]
        },
        "language": {
            "type": "string",
            "enum": ["cpp", "python", "py"]
        },
        "entry_file": { "type": "string", "minLength": 1 },
        "files": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "role"],
                "properties": {
                    "path": { "type": "string", "minLength": 1 },
                    "role": {
                        "type": "string",
                        "enum": ["source", "header", "script"]
                    }
                }
            }
        },
        "verified_against_suite": {
            "type": "object",
            "additionalProperties": false,
            "required": ["suite_id", "content_hash"],
            "properties": {
                "suite_id": { "type": "string", "minLength": 1 },
                "content_hash": { "type": "string", "minLength": 8 }
            }
        }
    }
}
