{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://algoag.local/schemas/suite.schema.json",
    "title": "AlgoAG Test suite manifest",
    "type": "object",
    "additionalProperties": false,
    "required": ["schema_version", "suite_id", "status", "samples"],
    "properties": {
        "schema_version": {
            "type": "integer",
            "minimum": 1
        },
        "suite_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "status": {
            "type": "string",
            "enum": ["draft", "frozen"]
        },
        "time_limit_ms": { "type": "integer", "minimum": 1 },
        "memory_limit_mb": { "type": "integer", "minimum": 1 },
        "samples": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "input_path", "output_path"],
                "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "input_path": { "type": "string", "minLength": 1 },
                    "output_path": { "type": "string", "minLength": 1 },
                    "public": { "type": "boolean" }
                }
            }
        },
        "generators": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
        },
        "seed_policy": { "type": "string" },
        "checksum": { "type": "string", "minLength": 8 }
    }
}
