{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://algoag.local/schemas/solution-bundle.schema.json",
    "title": "AlgoAG CP reference solution bundle (metadata.json)",
    "type": "object",
    "additionalProperties": false,
    "required": ["schema_version", "bundle_id", "artifacts"],
    "properties": {
        "schema_version": {
            "type": "integer",
            "minimum": 1
        },
        "bundle_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "status": {
            "type": "string",
            "enum": ["draft", "verified", "needs_review"]
        },
        "artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["solution_id", "language", "path", "entry_file", "role"],
                "properties": {
                    "solution_id": {
                        "type": "string",
                        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                    },
                    "language": {
                        "type": "string",
                        "enum": ["cpp", "python"]
                    },
                    "path": { "type": "string", "minLength": 1 },
                    "entry_file": { "type": "string", "minLength": 1 },
                    "role": {
                        "type": "string",
                        "enum": ["source", "header", "script"]
                    },
                    "status": {
                        "type": "string",
                        "enum": ["draft", "verified", "needs_review"]
                    }
                }
            }
        },
        "verified_against_suite": {
            "type": "object",
            "additionalProperties": false,
            "required": ["suite_id", "content_hash"],
            "properties": {
                "suite_id": { "type": "string", "minLength": 1 },
                "content_hash": { "type": "string", "minLength": 8 }
            }
        }
    }
}
