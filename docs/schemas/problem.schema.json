{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://algoag.local/schemas/problem.schema.json",
    "title": "AlgoAG Problem manifest",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "content_version",
        "problem_id",
        "status",
        "default_locale",
        "supported_locales",
        "limits",
        "translation_paths",
        "suite_refs"
    ],
    "properties": {
        "schema_version": {
            "type": "integer",
            "minimum": 1
        },
        "content_version": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
        },
        "problem_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "URL-friendly slug; defaults to problem_id when indexing"
        },
        "status": {
            "type": "string",
            "enum": ["draft", "review", "published", "archived"]
        },
        "default_locale": {
            "type": "string",
            "const": "ar"
        },
        "supported_locales": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
            }
        },
        "limits": {
            "type": "object",
            "additionalProperties": false,
            "required": ["time_limit_ms", "memory_limit_mb"],
            "properties": {
                "time_limit_ms": { "type": "integer", "minimum": 1 },
                "memory_limit_mb": { "type": "integer", "minimum": 1 }
            }
        },
        "pattern_ids": {
            "type": "array",
            "items": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
        },
        "difficulty": {
            "type": "string",
            "enum": ["easy", "medium", "hard"]
        },
        "judge": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "io_style": {
                    "type": "string",
                    "enum": ["stdin_stdout", "interactive"]
                },
                "checker": { "type": "string", "minLength": 1 }
            }
        },
        "translation_paths": {
            "type": "object",
            "additionalProperties": { "type": "string", "minLength": 1 },
            "propertyNames": { "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
            "minProperties": 1
        },
        "suite_refs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
        },
        "solution_refs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
        },
        "explanation_refs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
        },
        "analytics": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "topic_ids": {
                    "type": "array",
                    "items": { "type": "string" }
                },
                "skill_ids": {
                    "type": "array",
                    "items": { "type": "string" }
                },
                "estimated_minutes": { "type": "integer", "minimum": 1 }
            }
        },
        "titles": {
            "type": "object",
            "additionalProperties": { "type": "string", "minLength": 1 },
            "propertyNames": { "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
            "minProperties": 1,
            "description": "Optional display titles per locale (used for indexing and UI without parsing statement markdown)"
        },
        "cp_profile": {
            "type": "string",
            "const": "cp-v1",
            "description": "Marks manifests stored under content/cp/ with fixed companion files (explanation.ar.md, explanation.en.md)"
        }
    }
}
